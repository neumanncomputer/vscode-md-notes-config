{
  "Meeting Notes Template": {
    "scope": "markdown",
    "prefix": "mtg",
    "body": [
      "# ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}_$0",
      "",
      "## 事前タスク",
      "",
      "## 共有事項",
      "",
      "## 確認事項",
      "",
      "## 参加者",
      "",
      "## 議事内容",
      "",
      "## 決定事項",
      "",
      "## ネクストアクション",
      "",
    ],
    "description": "Meeting notes template",
  },
  "Journal Template": {
    "scope": "markdown",
    "prefix": "journal",
    "body": ["# ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}_journal", "", "## 今日のタスク", "", "- [ ] $0"],
    "description": "Journal template",
  },
  "Quick Note Template": {
    "scope": "markdown",
    "prefix": "note",
    "body": ["# ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}_${1:note}", "", "$0"],
    "description": "Quick note template",
  },
}
